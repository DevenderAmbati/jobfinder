# Backend — copy to backend/.env (never commit secrets)

# --- Required ---
# Local Docker: docker compose up -d
# Embedded fallback: npm run db:local-pg
DATABASE_URL="postgresql://jobfinder:jobfinder@localhost:5432/jobfinder?schema=public"
PORT=3001
NODE_ENV=development

# --- Logging ---
# debug | info | warn | error  (default: debug in development, info in production)
LOG_LEVEL=debug
# Write logs/error.log, cron.log, provider.log, telegram.log (default: true outside production)
LOG_TO_FILES=true
LOG_DIR=logs

# --- Dev tools ---
# In production, must be explicitly true to expose /api/dev/*
ENABLE_DEV_TOOLS=true

# --- Scheduler ---
# Process-level default tick + default frequency for new companies.
# CRON_FREQUENCY is preferred; CRON_DEFAULT_EXPRESSION is kept as an alias.
CRON_FREQUENCY="0 */6 * * *"
# CRON_DEFAULT_EXPRESSION="0 */6 * * *"

# --- Matching / AI ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
# Fallback threshold when no rule is active; the active rule's minMatchScore wins.
MATCH_SCORE_THRESHOLD=80
# Minimum rule fit before a job is worth an LLM call, and hard caps per run to
# protect free-tier quota and stop a rules change from flooding Telegram.
ESCALATION_FIT_FLOOR=60
MAX_ESCALATIONS_PER_RUN=40
MAX_NOTIFICATIONS_PER_RUN=15

# --- Telegram ---
# Shared bot for the app. Each user links their own chat in Settings.
TELEGRAM_BOT_TOKEN=
# Optional fallback for Dev Tools test when the signed-in user has not linked yet.
TELEGRAM_CHAT_ID=

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_CONCURRENT=2
# Set true in locked-down Linux containers if Chromium fails to start:
# PLAYWRIGHT_NO_SANDBOX=true

# --- Security ---
# Empty = same-origin only in production; open for local Vite. Or comma list / *
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_FETCH_MAX=30
REQUEST_LOGGING=true

# --- Frontend (Vite dev proxy only; production uses same-origin /api) ---
VITE_API_BASE_URL=http://localhost:3001/api
