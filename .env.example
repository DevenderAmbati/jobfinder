# Backend — copy to backend/.env (never commit secrets)

# --- Required ---
FIREBASE_PROJECT_ID=jobfinder-app
# Local: path to a service-account JSON. Cloud Run uses ADC automatically.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/serviceAccount.json
PORT=3001
NODE_ENV=development

# --- Logging ---
LOG_LEVEL=debug
LOG_TO_FILES=true
LOG_DIR=logs

# --- Dev tools ---
ENABLE_DEV_TOOLS=true

# --- Scheduler ---
CRON_FREQUENCY="0 */6 * * *"
# Local/dev: run node-cron in-process.
# Production daily scrape: GitHub Actions → scripts/fetch-all.ts (set false there).
# Legacy optional: Cloud Scheduler → /api/internal/schedule-tick
ENABLE_IN_PROCESS_CRON=true
INTERNAL_SCHEDULER_SECRET=

# --- Matching / AI ---
GEMINI_ENABLED=false
GEMINI_API_KEY=
MATCH_SCORE_THRESHOLD=80
ESCALATION_FIT_FLOOR=60
MAX_ESCALATIONS_PER_RUN=40
MAX_NOTIFICATIONS_PER_RUN=15

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# GitHub Actions / local batch: false (outbound alerts only).
# Only true if Cloud Run serves a public /api/telegram/webhook
TELEGRAM_WEBHOOK_MODE=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Playwright ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_CONCURRENT=2
# PLAYWRIGHT_NO_SANDBOX=true

# --- Storage ---
# FIREBASE_STORAGE_BUCKET=jobfinder-app.appspot.com

# --- Security ---
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_FETCH_MAX=30
REQUEST_LOGGING=true
