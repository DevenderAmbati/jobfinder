// Persistence schema — PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  REJECTED
  OFFER
  JOINED
}

enum ProviderRunStatus {
  IDLE
  RUNNING
  SUCCESS
  FAILURE
}

enum MatchSource {
  GEMINI
  KEYWORD
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String?
  /// Telegram destination after the user links via the bot deep-link.
  telegramChatId    String?           @unique
  /// One-time /start payload used to bind chat id → this account.
  telegramLinkToken String?           @unique
  telegramLinkedAt  DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  resume            Resume?
  rule              Rule?
  matches           JobMatch[]
  applications      Application[]
  notifications     NotificationLog[]
}

model Company {
  id           String        @id @default(cuid())
  name         String
  provider     String
  careerUrl    String
  enabled      Boolean       @default(true)
  frequency    String        @default("0 */6 * * *")
  lastRun      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         Job[]
  providerLogs ProviderLog[]
}

/// Shared job listing. Match scores live on JobMatch (per user), not here.
model Job {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])
  title         String
  location      String?
  description   String?
  experience    String?
  skills        String?
  salary        String?
  postedDate    DateTime?
  applyUrl      String
  provider      String
  dedupHash     String             @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  matches       JobMatch[]
  applications  Application[]
  notifications NotificationLog[]
}

/// Per-user resume↔job score. Companies/jobs are shared; scores are not.
model JobMatch {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  matchScore          Float
  matchReasons        String?
  missingSkills       String?
  interviewDifficulty String?
  salaryEstimate      String?
  recommendation      String?
  matchSource         MatchSource?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([userId, jobId])
  @@index([userId, matchScore])
}

/// Per-user matching preferences. Empty skills/roles/experience → resume-only scoring.
model Rule {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience    String?
  skills        String?
  roles         String?
  /// Notify / APPLY threshold for this user's match scores.
  minMatchScore Float    @default(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Resume {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalPdfPath String?
  extractedText   String
  markdown        String
  /// Future semantic search — nullable until embeddings land
  embedding       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Application {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(SAVED)
  notes     String?
  /// When the user first marked this role as applied (or later pipeline status).
  appliedAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([userId, appliedAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  /// Recipient account — null for legacy / synthetic notifications.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel   String   @default("telegram")
  success   Boolean
  payload   String?
  error     String?
  createdAt DateTime @default(now())

  @@index([userId, jobId])
}

model ProviderLog {
  id         String    @id @default(cuid())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  provider   String
  startTime  DateTime
  endTime    DateTime?
  jobsFound  Int       @default(0)
  jobsAdded  Int       @default(0)
  durationMs Int?
  error      String?
  createdAt  DateTime  @default(now())
}

model ProviderHealth {
  id                   String            @id @default(cuid())
  provider             String            @unique
  status               ProviderRunStatus @default(IDLE)
  lastRun              DateTime?
  lastSuccess          DateTime?
  averageExecutionTime Float             @default(0)
  failureCount         Int               @default(0)
  lastError            String?
  updatedAt            DateTime          @updatedAt
}

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String
  version   Int
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
}
