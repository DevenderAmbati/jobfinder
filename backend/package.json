{
  "name": "jobfinder-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Job Intelligence Platform API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:frontend": "npm --prefix ../frontend run build && node scripts/copy-frontend.mjs",
    "build": "npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:all": "npm run build:frontend && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed-firestore.ts",
    "seed:firestore": "tsx scripts/seed-firestore.ts",
    "fetch:all": "tsx scripts/fetch-all.ts",
    "fetch:retry-failed": "tsx scripts/fetch-all.ts --retry-failed",
    "db:prune-jobs": "tsx scripts/prune-jobs.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cron-parser": "^5.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
